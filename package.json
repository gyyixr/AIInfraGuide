{
  "name": "aiinfra-guide",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && node scripts/clean-search.mjs && astro build && pagefind --site dist && cp -r dist/pagefind public/pagefind",
    "preview": "astro preview",
    "site:local": "npm run build && astro preview --host 0.0.0.0 --port 4321",
    "dev:local": "astro dev --host 0.0.0.0 --port 4321",
    "lab:rl": "python3 labs/llm_rl/rl_lab.py --output labs/llm_rl/results/latest.json",
    "test:rl": "python3 -m unittest discover -s labs/llm_rl -p 'test_*.py' -v",
    "check:rl-site": "python3 scripts/check-rl-site.py",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/sitemap": "^3.1.6",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^4.16.19",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
